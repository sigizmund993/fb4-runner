# Settings of this robot. Copy to .env (it is not in git: every robot has its own).
# A variable set in the environment overrides this file.

# Robot id 0..15. The runner agrees it with the STM32 and writes it back here and to the
# hostname (fb4-NN) when it is changed with the robot's buttons. Empty: take the hostname's,
# or the STM32's if the hostname is not fb4-NN.
FB4_ROBOT_ID=
# yellow | blue
FB4_ROBOT_TEAM=yellow
FB4_UART_PORT=/dev/ttyACM0
# RICOCHET: lateral speed [1/s] per metre of ball offset seen by the onboard camera;
# flip the sign if the robot runs away from the ball
FB4_RICOCHET_CAM_GAIN=5.0

# Firmware for `make flash-fw`: CI releases of this branch of FB4_FW_REPO
FB4_FW_REPO=SPbUnited/FootBot4_Firmware
FB4_FW_BRANCH=feature/uart_for_rpi
# latest | a release number of the branch (5 or v0.0.5) | a full tag (feature-uart_for_rpi-v0.0.5)
FB4_FW_RELEASE=latest
